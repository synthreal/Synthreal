# Synthreal Agent OS — Example Configuration
# Copy to ~/.synthreal/config.toml and customize.

# API server settings
# api_key = ""                               # Set to enable Bearer auth (strongly recommended when exposing)
# api_listen = "127.0.0.1:50051"             # HTTP API bind address.
                                             # Use "0.0.0.0:<port>" to expose on LAN / Docker. The port must
                                             # match the port you publish (Docker image exposes 4200). You can
                                             # also override at runtime with SYNTHREAL_LISTEN=0.0.0.0:4200.
                                             # See docs/configuration.md "Exposing the Dashboard".

[default_model]
provider = "openrouter"                   # "openrouter", "anthropic", "gemini", "openai", "groq", "ollama", etc.
model = "openrouter/openai/gpt-oss-120b:free"  # Free, powerful, tool-capable default
api_key_env = "OPENROUTER_API_KEY"        # Environment variable holding API key
# base_url = "https://openrouter.ai/api/v1"    # Optional: override API endpoint
#
# Free-tier setup: create a key at https://openrouter.ai/keys and export it:
#   export OPENROUTER_API_KEY="sk-or-..."
# Task-based routing picks the best free model per request (see [routing]).
# Other strong free aliases: "free" (Llama 3.3 70B), "free-reasoning"
# (DeepSeek R1), "openrouter/free-coder" (Qwen3 Coder).

# Task-complexity routing (all free OpenRouter models by default)
# [routing]
# simple_model = "openrouter/meta-llama/llama-3.3-70b-instruct:free"   # fast chat
# medium_model = "openrouter/openai/gpt-oss-120b:free"                 # general agent work
# complex_model = "openrouter/deepseek/deepseek-r1:free"               # deep reasoning

[memory]
decay_rate = 0.05                         # Memory confidence decay rate
# sqlite_path = "~/.synthreal/data/synthreal.db"   # Optional: custom DB path

[network]
listen_addr = "127.0.0.1:4200"           # OFP listen address
# shared_secret = ""                      # Required for P2P authentication

# Session compaction (LLM-based context management)
# [compaction]
# threshold = 80                          # Compact when messages exceed this count
# keep_recent = 20                        # Keep this many recent messages after compaction
# max_summary_tokens = 1024               # Max tokens for LLM summary

# Usage tracking display
# usage_footer = "Full"                   # "Off", "Tokens", "Cost", or "Full"

# Channel adapters (configure tokens via environment variables)
# [telegram]
# bot_token_env = "TELEGRAM_BOT_TOKEN"
# allowed_users = []                      # Empty = allow all

# [discord]
# bot_token_env = "DISCORD_BOT_TOKEN"
# guild_ids = []                          # Empty = all guilds

# [slack]
# bot_token_env = "SLACK_BOT_TOKEN"
# app_token_env = "SLACK_APP_TOKEN"

# MCP server connections
# [[mcp_servers]]
# name = "filesystem"
# command = "npx"
# args = ["-y", "@modelcontextprotocol/server-filesystem", "/tmp"]
